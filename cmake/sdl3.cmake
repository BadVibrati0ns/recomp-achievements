# SDL3 for the desktop app. Only with RECOMP_ACH_APP; a game's build never
# needs SDL3 unless it sets RECOMP_ACH_SDL3_TARGET itself.
if(NOT RECOMP_ACH_APP)
  return()
endif()
if(NOT RECOMP_ACH_UI)
  message(FATAL_ERROR "RECOMP_ACH_APP needs RECOMP_ACH_UI")
endif()

if(RECOMP_ACH_SDL3_TARGET)
  # The consumer's own SDL3.
elseif(RECOMP_ACH_SDL3_SOURCE_DIR)
  # Only what the app uses: a window, the 2D renderer, events and gamepads.
  set(SDL_SHARED OFF)
  set(SDL_STATIC ON)
  set(SDL_INSTALL OFF)
  set(SDL_TEST_LIBRARY OFF)
  set(SDL_TESTS OFF)
  set(SDL_EXAMPLES OFF)
  set(SDL_UNINSTALL OFF)
  set(SDL_VIDEO ON)
  set(SDL_RENDER ON)
  set(SDL_JOYSTICK ON)
  set(SDL_HIDAPI ON)
  set(SDL_AUDIO OFF)
  set(SDL_GPU OFF)
  set(SDL_CAMERA OFF)
  set(SDL_HAPTIC OFF)
  set(SDL_SENSOR OFF)
  set(SDL_POWER OFF)
  set(SDL_DIALOG OFF)
  set(SDL_TRAY OFF)
  set(SDL_VULKAN OFF)
  set(SDL_OPENVR OFF)
  set(SDL_IBUS OFF)
  # The offscreen and dummy drivers let the window open without a display.
  set(SDL_OFFSCREEN ON)
  set(SDL_DUMMYVIDEO ON)
  add_subdirectory(${RECOMP_ACH_SDL3_SOURCE_DIR} ${CMAKE_BINARY_DIR}/sdl3 EXCLUDE_FROM_ALL)
  set(RECOMP_ACH_SDL3_TARGET SDL3::SDL3-static)
else()
  find_package(SDL3 REQUIRED CONFIG)
  set(RECOMP_ACH_SDL3_TARGET SDL3::SDL3)
endif()
